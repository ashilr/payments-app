# Copy to `.env` and adjust for your environment (never commit real secrets).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-this-to-a-random-32-char-string-in-production
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Test environment appends `_test` to the database name (see config/packages/doctrine.yaml).
DATABASE_URL="mysql://app:app@127.0.0.1:3306/paysera?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> redis / cache ###
REDIS_URL="redis://127.0.0.1:6379"
###< redis / cache ###

###> transfer rate limiter (config/packages/rate_limiter.yaml) ###
RATE_LIMIT_TRANSFER_MAX_REQUESTS=10
RATE_LIMIT_TRANSFER_INTERVAL="1 minute"
###< transfer rate limiter ###
