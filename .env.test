APP_ENV=test
APP_DEBUG=0

# A fixed secret is fine for tests — never use this in production.
APP_SECRET=this-is-a-phpunit-test-secret-do-not-use-in-production

# DATABASE_URL is intentionally NOT overridden here.
# The base .env value (db:3306/paysera) is inherited, and Doctrine
# automatically appends "_test" in the test environment:
#   config/packages/doctrine.yaml → when@test.dbal.dbname_suffix: '_test'
# Resulting test database: paysera_test
#
# If you need a different host/credentials for tests, set DATABASE_URL
# in .env.test.local (which is git-ignored).

# ─── Redis ───────────────────────────────────────────────────────────────────
# Sessions → mock_file (framework.yaml when@test), no Redis needed.
# payment.cache pool → array adapter (cache.yaml when@test), no Redis needed.
# The value below satisfies the env-var resolver but no connection is opened.
REDIS_URL=redis://redis:6379

# Rate limiter: effectively unlimited in tests (when@test in rate_limiter.yaml
# already overrides these, but they must exist to satisfy the env-var resolver).
RATE_LIMIT_TRANSFER_MAX_REQUESTS=10000
RATE_LIMIT_TRANSFER_INTERVAL="1 minute"
